cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED OUTPUT OR NOT DEFINED ROOT OR NOT DEFINED SHADERS)
  message(FATAL_ERROR "Shader embedding requires OUTPUT, ROOT and SHADERS.")
endif()

function(jade_expand_shader path stack result)
  get_filename_component(absolute "${path}" ABSOLUTE)
  if(absolute IN_LIST stack)
    message(FATAL_ERROR "Recursive shader include: ${absolute}")
  endif()
  list(APPEND stack "${absolute}")
  get_filename_component(directory "${absolute}" DIRECTORY)
  file(READ "${absolute}" source)
  string(REGEX MATCHALL "#[ \t]*include[ \t]+\"[^\"]+\"" directives "${source}")
  foreach(directive IN LISTS directives)
    string(REGEX REPLACE "^[^\"]*\"([^\"]+)\".*$" "\\1" included "${directive}")
    jade_expand_shader("${directory}/${included}" "${stack}" expansion)
    string(REPLACE "${directive}" "${expansion}" source "${source}")
  endforeach()
  set(${result} "${source}" PARENT_SCOPE)
endfunction()

set(header "#pragma once\nnamespace Jade::Detail::Shaders {\n")
foreach(shader IN LISTS SHADERS)
  jade_expand_shader("${ROOT}/${shader}" "" source)
  string(FIND "${source}" ")JADE_SHADER\"" delimiter)
  if(NOT delimiter EQUAL -1)
    message(FATAL_ERROR "Shader contains the embedding delimiter: ${shader}")
  endif()
  get_filename_component(symbol "${shader}" NAME_WE)
  get_filename_component(stage "${shader}" EXT)
  if(stage STREQUAL ".vert")
    string(APPEND symbol "Vertex")
  elseif(stage STREQUAL ".frag")
    string(APPEND symbol "Fragment")
  else()
    message(FATAL_ERROR "Shader entry point must be a vertex or fragment stage: ${shader}")
  endif()
  if(NOT symbol MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Shader filename must form a C++ identifier: ${shader}")
  endif()
  if(symbol IN_LIST symbols)
    message(FATAL_ERROR "Duplicate embedded shader symbol: ${symbol}")
  endif()
  list(APPEND symbols "${symbol}")
  string(APPEND header "inline constexpr char ${symbol}[] = R\"JADE_SHADER(${source})JADE_SHADER\";\n")
endforeach()
string(APPEND header "}\n")
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}" "${header}")
